<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.wunamor</groupId>
    <artifactId>common</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>common</name>
    <description>shared DTOs / utilities for rabbit-communication services</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 只保留编译期需要的 Lombok；公共库不要引入 spring-boot-starter -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!--
      注意：这里绝对不要加 spring-boot-maven-plugin。
      它会在 package 阶段把 jar repackage 成可执行 fat jar（class 被挪进 BOOT-INF/classes），
      别的模块就无法把这个 jar 当普通依赖使用了。
    -->
</project>
