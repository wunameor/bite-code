<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wunamor.mybatisdemo.mapper.ArticleInfoMapper">

    <select id="getArticleInfoById" resultType="com.wunamor.mybatisdemo.model.ArticleInfo">
        select a.*, u.username
        from article_info as a
        join user_info as u on a.uid = u.id
        where a.id = #{id}
    </select>
</mapper>
