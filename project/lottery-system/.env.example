# 复制为 .env 后修改；.env 已被 .gitignore 忽略，不要提交真实密钥。
#   cp .env.example .env
#   chmod 600 .env

# 公网访问端口（映射到容器内 8080）
APP_PORT=26000

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=lottery_system
DB_USERNAME=lottery
DB_PASSWORD=change-me-db-password

# RabbitMQ（容器内使用，不对外暴露端口）
RABBITMQ_USERNAME=lottery
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=lottery

# JWT 签名密钥，必须是 Base64，解码后至少 32 字节。
# 生成方式：
#   openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# 抽奖补偿扫描，云上建议开启
COMPENSATION_ENABLED=true

# 可选：中奖邮件通知；不需要留空
MAIL_USERNAME=
MAIL_PASSWORD=
